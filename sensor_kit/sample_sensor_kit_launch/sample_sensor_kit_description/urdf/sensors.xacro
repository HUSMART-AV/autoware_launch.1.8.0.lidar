<?xml version="1.0"?>
<robot name="vehicle" xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:arg name="config_dir" default="$(find sample_sensor_kit_description)/config"/>
  <xacro:property name="calibration" value="${xacro.load_yaml('$(arg config_dir)/sensors_calibration.yaml')}"/>

  <!-- sensor kit -->
  <xacro:include filename="sensor_kit.xacro"/>
  <xacro:sensor_kit_macro
    parent="base_link"
    x="${calibration['base_link']['sensor_kit_base_link']['x']}"
    y="${calibration['base_link']['sensor_kit_base_link']['y']}"
    z="${calibration['base_link']['sensor_kit_base_link']['z']}"
    roll="${calibration['base_link']['sensor_kit_base_link']['roll']}"
    pitch="${calibration['base_link']['sensor_kit_base_link']['pitch']}"
    yaw="${calibration['base_link']['sensor_kit_base_link']['yaw']}"
  />

  <!-- JT128 mid-range perimeter lidars, mounted directly on the vehicle body -->
  <xacro:include filename="$(find velodyne_description)/urdf/VLP-16.urdf.xacro"/>
  <xacro:VLP-16 parent="base_link" name="jt128_front" topic="jt128_front/points" hz="10" samples="220" gpu="false">
    <origin
      xyz="${calibration['base_link']['jt128_front_base_link']['x']}
           ${calibration['base_link']['jt128_front_base_link']['y']}
           ${calibration['base_link']['jt128_front_base_link']['z']}"
      rpy="${calibration['base_link']['jt128_front_base_link']['roll']}
           ${calibration['base_link']['jt128_front_base_link']['pitch']}
           ${calibration['base_link']['jt128_front_base_link']['yaw']}"
    />
  </xacro:VLP-16>
  <xacro:VLP-16 parent="base_link" name="jt128_front_left" topic="jt128_front_left/points" hz="10" samples="220" gpu="false">
    <origin
      xyz="${calibration['base_link']['jt128_front_left_base_link']['x']}
           ${calibration['base_link']['jt128_front_left_base_link']['y']}
           ${calibration['base_link']['jt128_front_left_base_link']['z']}"
      rpy="${calibration['base_link']['jt128_front_left_base_link']['roll']}
           ${calibration['base_link']['jt128_front_left_base_link']['pitch']}
           ${calibration['base_link']['jt128_front_left_base_link']['yaw']}"
    />
  </xacro:VLP-16>
  <xacro:VLP-16 parent="base_link" name="jt128_front_right" topic="jt128_front_right/points" hz="10" samples="220" gpu="false">
    <origin
      xyz="${calibration['base_link']['jt128_front_right_base_link']['x']}
           ${calibration['base_link']['jt128_front_right_base_link']['y']}
           ${calibration['base_link']['jt128_front_right_base_link']['z']}"
      rpy="${calibration['base_link']['jt128_front_right_base_link']['roll']}
           ${calibration['base_link']['jt128_front_right_base_link']['pitch']}
           ${calibration['base_link']['jt128_front_right_base_link']['yaw']}"
    />
  </xacro:VLP-16>
  <xacro:VLP-16 parent="base_link" name="jt128_left" topic="jt128_left/points" hz="10" samples="220" gpu="false">
    <origin
      xyz="${calibration['base_link']['jt128_left_base_link']['x']}
           ${calibration['base_link']['jt128_left_base_link']['y']}
           ${calibration['base_link']['jt128_left_base_link']['z']}"
      rpy="${calibration['base_link']['jt128_left_base_link']['roll']}
           ${calibration['base_link']['jt128_left_base_link']['pitch']}
           ${calibration['base_link']['jt128_left_base_link']['yaw']}"
    />
  </xacro:VLP-16>
  <xacro:VLP-16 parent="base_link" name="jt128_right" topic="jt128_right/points" hz="10" samples="220" gpu="false">
    <origin
      xyz="${calibration['base_link']['jt128_right_base_link']['x']}
           ${calibration['base_link']['jt128_right_base_link']['y']}
           ${calibration['base_link']['jt128_right_base_link']['z']}"
      rpy="${calibration['base_link']['jt128_right_base_link']['roll']}
           ${calibration['base_link']['jt128_right_base_link']['pitch']}
           ${calibration['base_link']['jt128_right_base_link']['yaw']}"
    />
  </xacro:VLP-16>
  <xacro:VLP-16 parent="base_link" name="jt128_rear_left" topic="jt128_rear_left/points" hz="10" samples="220" gpu="false">
    <origin
      xyz="${calibration['base_link']['jt128_rear_left_base_link']['x']}
           ${calibration['base_link']['jt128_rear_left_base_link']['y']}
           ${calibration['base_link']['jt128_rear_left_base_link']['z']}"
      rpy="${calibration['base_link']['jt128_rear_left_base_link']['roll']}
           ${calibration['base_link']['jt128_rear_left_base_link']['pitch']}
           ${calibration['base_link']['jt128_rear_left_base_link']['yaw']}"
    />
  </xacro:VLP-16>
  <xacro:VLP-16 parent="base_link" name="jt128_rear_right" topic="jt128_rear_right/points" hz="10" samples="220" gpu="false">
    <origin
      xyz="${calibration['base_link']['jt128_rear_right_base_link']['x']}
           ${calibration['base_link']['jt128_rear_right_base_link']['y']}
           ${calibration['base_link']['jt128_rear_right_base_link']['z']}"
      rpy="${calibration['base_link']['jt128_rear_right_base_link']['roll']}
           ${calibration['base_link']['jt128_rear_right_base_link']['pitch']}
           ${calibration['base_link']['jt128_rear_right_base_link']['yaw']}"
    />
  </xacro:VLP-16>
  <xacro:VLP-16 parent="base_link" name="jt128_rear" topic="jt128_rear/points" hz="10" samples="220" gpu="false">
    <origin
      xyz="${calibration['base_link']['jt128_rear_base_link']['x']}
           ${calibration['base_link']['jt128_rear_base_link']['y']}
           ${calibration['base_link']['jt128_rear_base_link']['z']}"
      rpy="${calibration['base_link']['jt128_rear_base_link']['roll']}
           ${calibration['base_link']['jt128_rear_base_link']['pitch']}
           ${calibration['base_link']['jt128_rear_base_link']['yaw']}"
    />
  </xacro:VLP-16>
</robot>
