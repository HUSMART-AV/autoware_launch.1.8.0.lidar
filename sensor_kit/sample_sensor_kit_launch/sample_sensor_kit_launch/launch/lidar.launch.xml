<launch>
  <arg name="launch_driver" default="true"/>
  <arg name="host_ip" default="192.168.1.10"/>
  <arg name="use_concat_filter" default="true"/>
  <arg name="vehicle_id" default="$(env VEHICLE_ID default)"/>
  <arg name="vehicle_mirror_param_file"/>
  <arg name="pointcloud_container_name" default="pointcloud_container"/>

  <!-- Per-lidar enable flags for INCREMENTAL bring-up. Flip a jt128_* to "true" to add
       that lidar, relaunch, and see if the shared container still survives. Lets us find
       the exact lidar count where it crashes without touching the group structure. -->
  <arg name="enable_ot128_top" default="true"/>
  <arg name="enable_jt128_front" default="false"/>
  <arg name="enable_jt128_front_left" default="false"/>
  <arg name="enable_jt128_front_right" default="false"/>
  <arg name="enable_jt128_left" default="false"/>
  <arg name="enable_jt128_right" default="false"/>
  <arg name="enable_jt128_rear_left" default="false"/>
  <arg name="enable_jt128_rear_right" default="false"/>
  <arg name="enable_jt128_rear" default="false"/>

  <group>
    <push-ros-namespace namespace="lidar"/>

    <!-- Single shared multithreaded container for all enabled lidars' preprocessing +
         concatenation, referenced below by its absolute name
         /sensing/lidar/pointcloud_container. -->
    <node pkg="rclcpp_components" exec="component_container_mt" name="pointcloud_container" output="screen"/>

    <!-- OT128: Hesai 128-channel long-range, roof-mounted (instrumented range 0.3-230m) -->
    <group>
      <push-ros-namespace namespace="ot128_top"/>
      <include file="$(find-pkg-share common_sensor_launch)/launch/hesai_OT128.launch.xml" if="$(var enable_ot128_top)">
        <arg name="max_range" value="230.0"/>
        <arg name="min_range" value="0.3"/>
        <arg name="sensor_frame" value="ot128_top"/>
        <arg name="sensor_ip" value="192.168.1.201"/>
        <arg name="host_ip" value="$(var host_ip)"/>
        <arg name="data_port" value="2368"/>
        <arg name="scan_phase" value="0.0"/>
        <arg name="launch_driver" value="$(var launch_driver)"/>
        <arg name="vehicle_mirror_param_file" value="$(var vehicle_mirror_param_file)"/>
        <arg name="container_name" value="/sensing/lidar/pointcloud_container"/>
      </include>
    </group>

    <!-- JT128 x8: Hesai 128-channel mid-range perimeter ring (instrumented range 0-60m) -->
    <group>
      <push-ros-namespace namespace="jt128_front"/>
      <include file="$(find-pkg-share common_sensor_launch)/launch/hesai_JT128.launch.xml" if="$(var enable_jt128_front)">
        <arg name="max_range" value="60.0"/>
        <arg name="min_range" value="0.05"/>
        <arg name="sensor_frame" value="jt128_front"/>
        <arg name="sensor_ip" value="192.168.1.202"/>
        <arg name="host_ip" value="$(var host_ip)"/>
        <arg name="data_port" value="2369"/>
        <arg name="scan_phase" value="0.0"/>
        <arg name="launch_driver" value="$(var launch_driver)"/>
        <arg name="vehicle_mirror_param_file" value="$(var vehicle_mirror_param_file)"/>
        <arg name="container_name" value="/sensing/lidar/pointcloud_container"/>
      </include>
    </group>

    <group>
      <push-ros-namespace namespace="jt128_front_left"/>
      <include file="$(find-pkg-share common_sensor_launch)/launch/hesai_JT128.launch.xml" if="$(var enable_jt128_front_left)">
        <arg name="max_range" value="60.0"/>
        <arg name="min_range" value="0.05"/>
        <arg name="sensor_frame" value="jt128_front_left"/>
        <arg name="sensor_ip" value="192.168.1.203"/>
        <arg name="host_ip" value="$(var host_ip)"/>
        <arg name="data_port" value="2370"/>
        <arg name="scan_phase" value="0.0"/>
        <arg name="launch_driver" value="$(var launch_driver)"/>
        <arg name="vehicle_mirror_param_file" value="$(var vehicle_mirror_param_file)"/>
        <arg name="container_name" value="/sensing/lidar/pointcloud_container"/>
      </include>
    </group>

    <group>
      <push-ros-namespace namespace="jt128_front_right"/>
      <include file="$(find-pkg-share common_sensor_launch)/launch/hesai_JT128.launch.xml" if="$(var enable_jt128_front_right)">
        <arg name="max_range" value="60.0"/>
        <arg name="min_range" value="0.05"/>
        <arg name="sensor_frame" value="jt128_front_right"/>
        <arg name="sensor_ip" value="192.168.1.204"/>
        <arg name="host_ip" value="$(var host_ip)"/>
        <arg name="data_port" value="2371"/>
        <arg name="scan_phase" value="0.0"/>
        <arg name="launch_driver" value="$(var launch_driver)"/>
        <arg name="vehicle_mirror_param_file" value="$(var vehicle_mirror_param_file)"/>
        <arg name="container_name" value="/sensing/lidar/pointcloud_container"/>
      </include>
    </group>

    <group>
      <push-ros-namespace namespace="jt128_left"/>
      <include file="$(find-pkg-share common_sensor_launch)/launch/hesai_JT128.launch.xml" if="$(var enable_jt128_left)">
        <arg name="max_range" value="60.0"/>
        <arg name="min_range" value="0.05"/>
        <arg name="sensor_frame" value="jt128_left"/>
        <arg name="sensor_ip" value="192.168.1.205"/>
        <arg name="host_ip" value="$(var host_ip)"/>
        <arg name="data_port" value="2372"/>
        <arg name="scan_phase" value="0.0"/>
        <arg name="launch_driver" value="$(var launch_driver)"/>
        <arg name="vehicle_mirror_param_file" value="$(var vehicle_mirror_param_file)"/>
        <arg name="container_name" value="/sensing/lidar/pointcloud_container"/>
      </include>
    </group>

    <group>
      <push-ros-namespace namespace="jt128_right"/>
      <include file="$(find-pkg-share common_sensor_launch)/launch/hesai_JT128.launch.xml" if="$(var enable_jt128_right)">
        <arg name="max_range" value="60.0"/>
        <arg name="min_range" value="0.05"/>
        <arg name="sensor_frame" value="jt128_right"/>
        <arg name="sensor_ip" value="192.168.1.206"/>
        <arg name="host_ip" value="$(var host_ip)"/>
        <arg name="data_port" value="2373"/>
        <arg name="scan_phase" value="0.0"/>
        <arg name="launch_driver" value="$(var launch_driver)"/>
        <arg name="vehicle_mirror_param_file" value="$(var vehicle_mirror_param_file)"/>
        <arg name="container_name" value="/sensing/lidar/pointcloud_container"/>
      </include>
    </group>

    <group>
      <push-ros-namespace namespace="jt128_rear_left"/>
      <include file="$(find-pkg-share common_sensor_launch)/launch/hesai_JT128.launch.xml" if="$(var enable_jt128_rear_left)">
        <arg name="max_range" value="60.0"/>
        <arg name="min_range" value="0.05"/>
        <arg name="sensor_frame" value="jt128_rear_left"/>
        <arg name="sensor_ip" value="192.168.1.207"/>
        <arg name="host_ip" value="$(var host_ip)"/>
        <arg name="data_port" value="2374"/>
        <arg name="scan_phase" value="0.0"/>
        <arg name="launch_driver" value="$(var launch_driver)"/>
        <arg name="vehicle_mirror_param_file" value="$(var vehicle_mirror_param_file)"/>
        <arg name="container_name" value="/sensing/lidar/pointcloud_container"/>
      </include>
    </group>

    <group>
      <push-ros-namespace namespace="jt128_rear_right"/>
      <include file="$(find-pkg-share common_sensor_launch)/launch/hesai_JT128.launch.xml" if="$(var enable_jt128_rear_right)">
        <arg name="max_range" value="60.0"/>
        <arg name="min_range" value="0.05"/>
        <arg name="sensor_frame" value="jt128_rear_right"/>
        <arg name="sensor_ip" value="192.168.1.208"/>
        <arg name="host_ip" value="$(var host_ip)"/>
        <arg name="data_port" value="2375"/>
        <arg name="scan_phase" value="0.0"/>
        <arg name="launch_driver" value="$(var launch_driver)"/>
        <arg name="vehicle_mirror_param_file" value="$(var vehicle_mirror_param_file)"/>
        <arg name="container_name" value="/sensing/lidar/pointcloud_container"/>
      </include>
    </group>

    <group>
      <push-ros-namespace namespace="jt128_rear"/>
      <include file="$(find-pkg-share common_sensor_launch)/launch/hesai_JT128.launch.xml" if="$(var enable_jt128_rear)">
        <arg name="max_range" value="60.0"/>
        <arg name="min_range" value="0.05"/>
        <arg name="sensor_frame" value="jt128_rear"/>
        <arg name="sensor_ip" value="192.168.1.209"/>
        <arg name="host_ip" value="$(var host_ip)"/>
        <arg name="data_port" value="2376"/>
        <arg name="scan_phase" value="0.0"/>
        <arg name="launch_driver" value="$(var launch_driver)"/>
        <arg name="vehicle_mirror_param_file" value="$(var vehicle_mirror_param_file)"/>
        <arg name="container_name" value="/sensing/lidar/pointcloud_container"/>
      </include>
    </group>

    <include file="$(find-pkg-share sample_sensor_kit_launch)/launch/pointcloud_preprocessor.launch.py">
      <arg name="base_frame" value="base_link"/>
      <arg name="use_intra_process" value="true"/>
      <arg name="use_multithread" value="true"/>
      <arg name="pointcloud_container_name" value="/sensing/lidar/pointcloud_container"/>
    </include>
  </group>
</launch>
